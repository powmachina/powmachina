{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PowMachina Wallet",
  "version": "0.1.0",
  "identifier": "com.powmachina.wallet",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "windows": [
      {
        "title": "PowMachina Wallet",
        "width": 1000,
        "height": 700,
        "minWidth": 820,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage",
      "nsis",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/powmachina-wallet-rpc",
      "binaries/powmachinad"
    ],
    "shortDescription": "PowMachina Wallet",
    "longDescription": "Desktop wallet for the PowMachina network. Your keys stay on your machine."
  }
}
